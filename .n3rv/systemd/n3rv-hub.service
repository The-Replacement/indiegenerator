[Unit]
Description=N3RV A2A Hub for indiegenerator
After=network.target

[Service]
Type=simple
WorkingDirectory=.
ExecStart=/home/estrocondoso/.local/share/mise/installs/python/3.14.8/bin/n3rv hub start
# Hardening: keep these in the template. A re-render overwrites the installed
# unit, so anything added only to ~/.config/systemd/user is lost on update.
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
TimeoutStopSec=30s
Restart=on-failure
RestartSec=5
StandardOutput=append:./.n3rv/logs/hub.log
StandardError=append:./.n3rv/logs/hub.log

[Install]
WantedBy=default.target