# virtualenvs
.venv/
venv/

# python build / cache
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# render output
out*/
*.flac
!presets/**/*.flac
*.json.tmp

# editors / OS
.idea/
.vscode/
.DS_Store

# N3RV — generated. Ignored, EXCEPT files that were already tracked before
# this rule existed: AGENTS.md, opencode.json and opencode.template.json are
# still tracked here and stay reviewable in diffs. The declared state is
# committed on purpose — it is what a reviewer reads before the generator runs.
.n3rv/*
!.n3rv/state.yaml
.opencode/
.githooks/
.specify/
AGENTS.md
constitution.md
opencode.json
opencode.template.json
