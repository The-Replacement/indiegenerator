{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "n3rv",
    "instructions": [
        "AGENTS.md",
        "CONTRIBUTING.md",
        "SECURITY.md",
        "docs/*.md"
    ],
    "mcp": {
        "servers": {
            "sequential-thinking": {
                "type": "local",
                "command": [
                    "npx",
                    "-y",
                    "@modelcontextprotocol/server-sequential-thinking@2.1.1"
                ]
            },
            "n3rv-hub": {
                "type": "local",
                "command": [
                    "/home/estrocondoso/.local/share/mise/installs/python/3.14.8/bin/n3rv-hub"
                ],
                "environment": {
                    "N3RV_AGENT_ID": "indiegenerator",
                    "N3RV_AGENT_SOURCE": "opencode"
                }
            }
        }
    },
    "agents": {
        "build": {
            "disabled": true
        },
        "plan": {
            "disabled": true
        }
    },
    "commands": {
        "sdd-new": {
            "template": "Run the full 8-phase SDD pipeline for the given change. Use the SDD skills under .opencode/skills/ and delegate to sdd subagents via the task tool for phases 1-5, then implement for phase 6, verify with sdd-verifier for phase 7, and archive with sdd-archiver for phase 8. Run sequentially: explore -> propose -> spec -> design -> tasks -> apply -> verify -> archive. Change: $ARGUMENTS",
            "description": "Run full Spec-Driven Development pipeline"
        }
    },
    "permissions": [
        {
            "action": "websearch",
            "resource": "*",
            "effect": "allow"
        }
    ]
}
