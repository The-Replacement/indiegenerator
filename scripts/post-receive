#!/bin/sh
# post-receive — runs ON the mainframe, in ~/servers/indiegenerator.
# Install (copy, NOT symlink): HOOKS=$(git rev-parse --git-path hooks);
#   install -m 0755 scripts/post-receive "$HOOKS/post-receive"
# Requires receive.denyCurrentBranch=updateInstead (git moves the worktree
# before this hook runs; do NOT fetch or reset).
#
# A push rebuilds and brings up ONLY indiegen. It does not touch
# icecast/liquidsoap: --no-deps avoids recreating dependencies. And no
# --no-recreate: after a build it would leave the old image running.
#
# On-push rotation: the policy is NOT here; it is read from the radio's .env
# (INDIEGEN_AUTO_TRIGGER) on every push. 1 = every push rotates the library
# (full render ~6 min + liquidsoap restart + ~10 s of cut). 0 or absent =
# the push only deploys code.
set -eu

RADIO_DIR="${RADIO_DIR:-$HOME/servers/radio}"
LOG="$RADIO_DIR/data/indiegen/deploy.log"
mkdir -p "$(dirname "$LOG")"
log() { printf '[%s] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >> "$LOG"; }

# Rotation policy, read from the .env on every push: changing it does not
# require touching or reinstalling this hook.
AUTO_TRIGGER=$(sed -n 's/^[[:space:]]*INDIEGEN_AUTO_TRIGGER[[:space:]]*=[[:space:]]*//p' \
  "$RADIO_DIR/.env" 2>/dev/null | tail -1 | tr -d ' \t\r\"')
AUTO_TRIGGER="${AUTO_TRIGGER:-0}"

while read -r OLD NEW REF; do
  case "$REF" in
    refs/heads/*) ;;
    *) continue ;;
  esac
  # updateInstead moves the worktree only when the pushed ref IS the branch
  # checked out here. Any other branch updates a ref nobody has: the worktree
  # keeps the previous commit while this hook would rebuild stale code and
  # log success. This box checks out $HEAD_REF; a push to anything else is
  # not a deploy (infra#12).
  HEAD_REF="$(git symbolic-ref -q HEAD || true)"
  if [ -z "$HEAD_REF" ]; then
    log "FAIL: HEAD is detached; updateInstead cannot move the worktree. Deploy did nothing."
    exit 1
  fi
  if [ "$REF" != "$HEAD_REF" ]; then
    log "FAIL: pushed $REF but HEAD is on $HEAD_REF; updateInstead would leave the worktree where it is. Push $HEAD_REF instead."
    exit 1
  fi
  # The worktree must actually be at the pushed commit: that is the tree the
  # containers mount, and the only commit this deploy is allowed to serve.
  WORKTREE_SHA="$(git rev-parse HEAD)"
  if [ "$WORKTREE_SHA" != "$NEW" ]; then
    log "FAIL: worktree is at $WORKTREE_SHA, not $NEW; refusing to deploy a tree that does not contain the push"
    exit 1
  fi
  log "indiegenerator push ${OLD}..${NEW}; worktree moved to $WORKTREE_SHA"
  if ! docker compose -f "$RADIO_DIR/docker-compose.yml" build indiegen >>"$LOG" 2>&1; then
    log "FAIL: build indiegen — the container keeps the previous image"
    exit 1
  fi
  log "build ok: up -d --no-deps indiegen"
  if ! docker compose -f "$RADIO_DIR/docker-compose.yml" up -d --no-deps indiegen >>"$LOG" 2>&1; then
    log "FAIL: up indiegen — check $LOG"
    exit 1
  fi
  if [ "$AUTO_TRIGGER" = "1" ]; then
    if ! date -u +%Y-%m-%dT%H:%M:%SZ > "$RADIO_DIR/data/indiegen/trigger"; then
      log "FAIL: deploy ok but could not write the trigger (permissions on data/indiegen)"
      exit 1
    fi
    log "deploy ready + cycle triggered (INDIEGEN_AUTO_TRIGGER=1)"
  else
    log "deploy ready (no cycle; INDIEGEN_AUTO_TRIGGER=${AUTO_TRIGGER})"
  fi
done
exit 0
